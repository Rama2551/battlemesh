def age_str(secs):
    """'hace 3 min' / 'hace 2 h' / 'hace 4 d'."""
    secs = int(secs)
    if secs < 60:
        return f"hace {secs}s"
    if secs < 3600:
        return f"hace {secs // 60} min"
    if secs < 86400:
        return f"hace {secs // 3600} h"
    return f"hace {secs // 86400} d"

def _self_update():
    """Descarga la última versión desde GitHub y se reemplaza a sí mismo."""
    import urllib.request
    import re as _re
    dest = os.path.realpath(__file__)
    print(f"BATTLEMESH {VERSION}")
    print(f"Buscando actualizaciones en {UPDATE_URL} …")
    try:
        url = UPDATE_URL + ("&" if "?" in UPDATE_URL else "?") + f"nocache={int(time.time())}"
        req = urllib.request.Request(
            url,
            headers={"Cache-Control": "no-cache", "Pragma": "no-cache",
                     "User-Agent": f"battlemesh/{VERSION}"})
        with urllib.request.urlopen(req, timeout=30) as r:
            nuevo = r.read().decode("utf-8")
    except Exception as e:
        print(f"✗ No pude descargar la actualización: {e}")
        return 1
    if not nuevo.lstrip().startswith("#!") or "class MeshApp" not in nuevo:
        print("✗ Lo descargado no parece BATTLEMESH. No toco nada.")
        return 1
    mm = _re.search(r'^VERSION\s*=\s*"([^"]+)"', nuevo, _re.M)
    remota = mm.group(1) if mm else "?"
    if remota == VERSION:
        print(f"✓ Ya tenés la última versión ({VERSION}).")
        return 0
    if remota == "?":
        print("⚠ No pude leer la versión de la copia remota; la instalo igual.")
    else:
        print(f"Nueva versión disponible: {remota}  (tenés {VERSION})")
    try:
        compile(nuevo, dest, "exec")
    except SyntaxError as e:
        print(f"✗ La descarga está corrupta: {e}. No toco nada.")
        return 1
    respaldo = dest + f".backup-{VERSION}"
    try:
        shutil.copy2(dest, respaldo)
        tmp = dest + ".new"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(nuevo)
        os.chmod(tmp, os.stat(dest).st_mode)
        os.replace(tmp, dest)
    except PermissionError:
        print(f"✗ Sin permisos para escribir en {dest}")
        print(f"  Probá:  sudo {dest} --update")
        return 1
    except Exception as e:
        print(f"✗ Error al actualizar: {e}")
        return 1
    print(f"✅ Actualizado a {remota}.  (copia previa en {respaldo})")
    return 0


