def splash(port):
    """Pantalla de carga mostrada mientras conecta el ESP."""
    GRAY = "\033[38;5;250m"; GREEN = "\033[1;32m"; DIM = "\033[2m"
    YEL = "\033[1;33m"; OFF = "\033[0m"
    try:
        sys.stdout.write("\033[2J\033[H")   # limpiar pantalla
        print(GRAY + RIFLE_ART + OFF)
        print(GREEN + BANNER_ART + OFF)
        print("                    " + DIM + "dev: Ramiro Spinolo" + OFF)
        print()
        print(YEL + f"   ▶ Conectando al nodo en {port} …" + OFF)
        sys.stdout.flush()
    except Exception:
        print(f"BATTLEMESH - conectando en {port} ...")


class ConvoItem(ListItem):
    """Un item de la lista de conversaciones, guarda su clave."""
    def __init__(self, key, label_text):
        self._label = Label(label_text)
        super().__init__(self._label)
        self.key = key
        self.label_text = label_text

    def set_text(self, text):
        self.label_text = text
        self._label.update(text)


class MeshApp(App):
