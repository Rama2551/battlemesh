def signal_level(snr, rssi=None):
    """Calidad de enlace 0-4 a partir del SNR (y RSSI si lo tenemos)."""
    if snr is None:
        return 0
    if snr >= -7:
        lvl = 4
    elif snr >= -12:
        lvl = 3
    elif snr >= -17:
        lvl = 2
    else:
        lvl = 1
    if rssi is not None and rssi < -115 and lvl > 1:
        lvl -= 1          # señal muy débil aunque el SNR ayude
    return lvl


def signal_bars(level):
    """Marcador de señal tipo celular: barras llenas + huecas."""
    full = "▂▄▆█"
    empty = "▁▁▁▁"
    level = max(0, min(4, level))
    return full[:level] + empty[level:]


