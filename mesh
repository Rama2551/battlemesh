#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BATTLEMESH - TUI visual (con mouse) para tu nodo Meshtastic por USB. 100% local, sin internet.

Uso:  battlemesh              (autodetecta la placa LoRa conectada por USB)
      battlemesh /dev/ttyUSB1 (forzar un puerto)

Panel izquierdo (clickeable con el mouse): conversaciones
  📢 Broadcast / canales  -> mensajes a todo un grupo
  💬 <nodo>               -> mensaje directo (DM) a un solo nodo
Escribí abajo y Enter para enviar.
Teclas:  F2 sonido on/off · F3 borrar historial de la conversación · F5 refrescar · q/Ctrl+C salir
El historial se guarda solo en ~/.local/share/mesh-tui/history.json y se recarga al abrir.
"""
import sys
import os
import json
import time
import shutil
import subprocess
from pathlib import Path
from datetime import datetime

# ---------- auto-instalador de dependencias (portable, corre en cualquier PC) ----------
def _ensure_deps():
    """Si faltan meshtastic/textual, crea un venv propio, las instala y re-lanza."""
    try:
        import meshtastic, textual, pubsub  # noqa
        return
    except ImportError:
        pass
    import os, subprocess, venv, pathlib
    venv_dir = pathlib.Path(os.environ.get("MESH_VENV",
                            pathlib.Path.home() / ".local/share/mesh-tui/venv"))
    py = venv_dir / "bin" / "python"
    if not py.exists():
        print("Primera vez en esta máquina: preparando el entorno (1-2 min, necesita internet)…")
        try:
            venv.create(venv_dir, with_pip=True)
        except Exception as e:
            sys.exit("No pude crear el entorno virtual.\n"
                     "En Debian/Mint/Ubuntu instalá primero:  sudo apt install python3-venv\n"
                     f"Detalle: {e}")
        subprocess.check_call([str(py), "-m", "pip", "install", "-q", "--upgrade", "pip"])
        subprocess.check_call([str(py), "-m", "pip", "install", "-q", "meshtastic", "textual"])
        print("Entorno listo ✅")
    os.execv(str(py), [str(py), os.path.abspath(__file__)] + sys.argv[1:])

_ensure_deps()

if "--check" in sys.argv:
    import meshtastic, textual
    print("deps OK  ->  textual", getattr(textual, "__version__", "?"),
          "| meshtastic importado")
    sys.exit(0)

ONLINE_SECS = 300      # se considera "online" si se lo escuchó hace < 5 min
REFRESH_SECS = 10      # refresco de la lista de nodos

try:
    from meshtastic.serial_interface import SerialInterface
    from pubsub import pub
except Exception as e:
