# Códigos de evento de entrada del firmware (para controlar la pantalla del Heltec remotamente)
INPUT_UP, INPUT_DOWN, INPUT_LEFT, INPUT_RIGHT, INPUT_SELECT = 17, 18, 19, 20, 10

BROADCAST_NUM = 0xFFFFFFFF

DATA_DIR = Path(os.environ.get("MESH_DATA", Path.home() / ".local/share/mesh-tui"))
HISTORY_FILE = DATA_DIR / "history.json"
CONFIG_FILE = DATA_DIR / "config.json"
MAX_PER_CONVO = 800   # tope de mensajes guardados por conversacion


def ts():
    return datetime.now().strftime("%H:%M:%S")


def key_to_str(key):
    return f"{key[0]}:{key[1]}"


def str_to_key(s):
    kind, val = s.split(":", 1)
    return (kind, int(val))


